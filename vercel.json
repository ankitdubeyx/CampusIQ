{
  "version": 2,
  "rewrites": [
    { "source": "/api", "destination": "/api/index.js" },
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/dashboard", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "data/**"
    }
  }
}
